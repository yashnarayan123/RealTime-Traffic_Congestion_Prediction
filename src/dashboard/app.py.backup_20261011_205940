def apply_chart_style(fig, height=400):
    """Apply the dashboard's dark Plotly theme without duplicating axis arguments."""
    fig.update_layout(
        paper_bgcolor="#06091a",
        plot_bgcolor="#06091a",
        font=dict(
            color="#c5d0e8",
            family="Inter, Arial, sans-serif",
            size=12,
        ),
        margin=dict(l=10, r=20, t=55, b=20),
        height=height,
        title_font=dict(
            size=14,
            color="#eaf0ff",
            family="Inter, Arial, sans-serif",
        ),
        hoverlabel=dict(
            bgcolor="#101828",
            font_color="#eaf0ff",
            bordercolor="#1f2d4a",
        ),
        legend=dict(
            bgcolor="rgba(0,0,0,0)",
            bordercolor="#1f2d4a",
        ),
    )

    fig.update_xaxes(
        gridcolor="#131d30",
        zerolinecolor="#1a2540",
        tickfont=dict(color="#7a8fb5", size=11),
        title_font=dict(color="#c5d0e8"),
        linecolor="#1a2540",
    )

    fig.update_yaxes(
        gridcolor="#131d30",
        zerolinecolor="#1a2540",
        tickfont=dict(color="#7a8fb5", size=11),
        title_font=dict(color="#c5d0e8"),
        linecolor="#1a2540",
    )

    return fig


