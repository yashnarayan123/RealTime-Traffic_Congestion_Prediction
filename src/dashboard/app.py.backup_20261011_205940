@st.cache_data(ttl=5)
def load_data():

    if not os.path.exists(PARQUET_DIR):
        return pd.DataFrame()

    try:
        df = pd.read_parquet(PARQUET_DIR)

        if df.empty:
            return df

        df["window_start"] = pd.to_datetime(
            df["window_start"],
            errors="coerce",
        )

        df["window_end"] = pd.to_datetime(
            df["window_end"],
            errors="coerce",
        )

        numeric_columns = [
            "avg_speed_kmh",
            "free_flow_speed_kmh",
            "congestion_percentage",
            "total_vehicles",
            "event_count",
            "accident_count",
        ]

        for column in numeric_columns:
            if column in df.columns:
                df[column] = pd.to_numeric(
                    df[column],
                    errors="coerce",
                )

        df = df.dropna(subset=["window_start", "road_name"])

        return df

    except Exception as e:
        st.error(f"Unable to read processed traffic data: {e}")
        return pd.DataFrame()


